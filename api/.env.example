# Copy to .env and edit if you want to change anything. Every value here has a
# working default, so the file is optional.

# --- database ---
# SQLite by default. Point this at Postgres in production.
# DATABASE_URL=postgresql://user:pass@host:5432/storesense

# --- the model ---
# Anything that speaks the OpenAI chat-completions API works. The defaults
# point at a local Ollama, which is free.
#
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
#
# Use an 8B or bigger. Smaller models quote the right figure and then invent a
# comparison around it, which is worse than being wrong outright.
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
# LLM_EMBED_MODEL=nomic-embed-text
# LLM_VISION_MODEL=llama3.2-vision

# To use OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_EMBED_MODEL=text-embedding-3-small
# LLM_VISION_MODEL=gpt-4o-mini

# --- shopify (optional) ---
# Leave blank to use the synthetic seeded data.
# SHOPIFY_STORE_DOMAIN=noszn.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...

# --- fine-tuned copy model (optional, off) ---
# Routes only the copy generator to the LoRA adapter in finetune/, leaving the
# copilot, search and sentiment on the main model — the adapter serves chat and
# nothing else.
#
#   cd finetune && python serve.py
#
# Recommended off. It learned the voice and still invents product facts;
# finetune/README.md has the numbers.
# COPY_LLM_BASE_URL=http://localhost:8100/v1
# COPY_LLM_MODEL=noszn-voice

# --- tuning ---
# LOW_STOCK_THRESHOLD=8
# RATE_LIMIT_REQUESTS=30

# --- login ---
# Leave blank and the dashboard is open, which is what you want on your laptop.
# Set it before deploying: without it, anyone who finds the URL can run up your
# LLM bill.
# APP_PASSWORD=

# Signs session tokens. Blank means a new one each boot, so a restart signs
# everyone out. Set it in production.
# SESSION_SECRET=

# --- weekly digest (optional) ---
# Only needed to email it. Without these it still prints and still shows on
# the dashboard.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# DIGEST_FROM=
# DIGEST_TO=
