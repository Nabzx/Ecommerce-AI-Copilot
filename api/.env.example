# Copy to .env and edit if you want to change anything. Every value here has a
# working default, so the file is optional.

# --- database ---
# SQLite by default. Point this at Postgres in production.
# DATABASE_URL=postgresql://user:pass@host:5432/storesense

# --- the model ---
# Anything that speaks the OpenAI chat-completions API works. The defaults
# point at a local Ollama, which is free.
#
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_EMBED_MODEL=nomic-embed-text
# LLM_VISION_MODEL=llama3.2-vision

# To use OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_EMBED_MODEL=text-embedding-3-small
# LLM_VISION_MODEL=gpt-4o-mini

# --- shopify (optional) ---
# Leave blank to use the synthetic seeded data.
# SHOPIFY_STORE_DOMAIN=noszn.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...

# --- tuning ---
# LOW_STOCK_THRESHOLD=8
# RATE_LIMIT_REQUESTS=30
